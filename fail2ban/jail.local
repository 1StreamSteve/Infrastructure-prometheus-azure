[DEFAULT]
bantime  = 3600
findtime = 600
maxretry = 5
banaction = ufw

[nginx-http-auth]
enabled  = true
port     = http,https
filter   = nginx-http-auth
logpath  = /var/log/nginx/prometheus.1stream.co.za.error.log
maxretry = 5

[nginx-limit-req]
enabled  = true
port     = http,https
filter   = nginx-limit-req
logpath  = /var/log/nginx/prometheus.1stream.co.za.error.log
maxretry = 10
